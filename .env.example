# Development defaults work with SQLite. Set these for production.
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ANALYTICS_IP_HASH_SALT=replace-with-a-different-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BOOTSTRAP_BASE_URL=http://localhost:3000
BOOTSTRAP_TOKEN_TTL_MINUTES=0
INVITATION_TTL_HOURS=48
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_ALERT_THRESHOLD=1000
NGINX_JSON_LOG_PATH=/var/log/nginx/access.json
PORT=3000

# Production PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=redirector_panel
POSTGRES_USER=redirector
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://redirector:replace-with-a-database-password@db:5432/redirector_panel

# Optional background processes and Telegram delivery
RUN_COLLECTOR=false
RUN_NOTIFICATION_WORKER=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Existing redirector edge service (only with --profile edge)
DOMAIN_NAME=
C2_SERVER=
C2_SCHEME=http
UA_PATTERN=
# Control plane address the edge proxies /g/ gate traffic to (host:port)
PANEL_UPSTREAM=panel:3000

# Release gates (defaults shown)
GATE_BASE_PATH=/g/
AGENT_BASE_PATH=/a/
# Auto-ban an IP after this many suspicious events within one hour (0 = off)
AUTO_BAN_THRESHOLD=5
# Optional nginx include files managed by the panel (empty = sync disabled)
NGINX_BAN_INCLUDE=
NGINX_AGENT_ROUTES_INCLUDE=
# pwndrop proxy safeguards
PWNDROP_TIMEOUT=10
PWNDROP_MAX_BYTES=536870912
# Undo window for approve/deny decisions (seconds)
DECISION_UNDO_SECONDS=10
# Embed per-visitor canary pixels in decoy pages (default on)
DECOY_CANARIES=true
# Domains this redirector serves; enables per-link domain pinning
REDIRECTOR_DOMAINS=
# Peers whose X-Forwarded-For header is trusted (nginx edge on the same host)
TRUSTED_PROXIES=127.0.0.1,::1
# Maximum accepted submission body from droppers/loaders
SUBMISSION_MAX_BYTES=4194304
# Web Push (VAPID) - generate with: python manage.py vapid_keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=mailto:operators@example.com
# Set true to skip the startup self-test gate (not recommended)
SELFTEST_SKIP=false
